{
  "name": "precentor",
  "version": "0.2.0",
  "description": "Sing the 1650 Scottish Psalter: every psalm, a choice of tunes, and a player that follows each syllable. One Expo app for the web, iOS and Android.",
  "main": "index.ts",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 5180",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "tsc --noEmit && expo export --platform web && node scripts/web-postbuild.mjs",
    "preview": "npx serve dist --single --listen 5180",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "corpus": "node scripts/import-corpus.mjs && node scripts/link-corpus.mjs",
    "postinstall": "node scripts/link-corpus.mjs && node scripts/patch-dom-webview.mjs",
    "eas-build-post-install": "node scripts/link-corpus.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "abcjs": "^6.7.2",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.19",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "1.0.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
